{
  "name": "@opengsn/paymasters",
  "license": "GPL-3.0-only",
  "version": "3.0.0-beta.10",
  "scripts": {
    "tsc": "tsc",
    "lint:js": "eslint -f unix .",
    "lint-fix": "eslint -f unix . --fix",
    "lint:sol": "solhint -f unix \"contracts/**/*.sol\" --max-warnings 0",
    "test": "yarn tsc",
    "typechain-generate": "yarn typechain-generate-ethers-v5",
    "typechain-generate-ethers-v5": "typechain --target ethers-v5 '../../out/*.sol/*.json'",
    "rm-dist": "rm -rf tsconfig.tsbuildinfo dist build"
  },
  "main": "dist/src/index.js",
  "files": [
    "src/*",
    "dist/src/*",
    "dist/build/*",
    "dist/types/*",
    "types/*",
    "contracts/*",
    "build/contracts/*",
    "README.md"
  ],
  "publishConfig": {
    "access": "public"
  },
  "dependencies": {
    "@metamask/eth-sig-util": "^5.1.0",
    "@opengsn/common": "^3.0.0-beta.10",
    "@opengsn/contracts": "^3.0.0-beta.10",
    "@opengsn/dev": "^3.0.0-beta.10",
    "@opengsn/provider": "^3.0.0-beta.10",
    "@openzeppelin/contracts": "^4.2.0",
    "@uniswap/v3-periphery": "^1.1.1",
    "ethereumjs-util": "^7.1.0",
    "web3": "^1.7.4",
    "web3-eth-abi": "^1.7.4",
    "web3-eth-accounts": "^1.7.4",
    "web3-eth-contract": "^1.7.4",
    "web3-utils": "^1.7.4"
  },
  "devDependencies": {
    "@ethersproject/abi": "^5.6.4",
    "@ethersproject/abstract-signer": "^5.7.0",
    "@ethersproject/providers": "^5.7.2",
    "@opengsn/cli": "^3.0.0-beta.10",
    "@openzeppelin/test-helpers": "^0.5.15",
    "@types/chai-as-promised": "^7.1.3",
    "@types/ethereumjs-util": "^6.1.0",
    "@types/web3": "1.2.2",
    "bn.js": "^5.2.1",
    "chai": "^4.2.0",
    "chai-as-promised": "^7.1.1",
    "chalk": "^4.1.2",
    "ethers": "^5.7.2",
    "solhint": "^3.3.2",
    "ts-node": "8.6.2",
    "web3-core": "^1.7.4"
  }
}
