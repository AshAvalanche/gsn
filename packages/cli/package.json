    "@opengsn/relay": "^3.0.0-beta.10",
    "@types/node": "^22.0.0",
    "commander": "^6.1.0",
    "console-read-write": "^0.1.1",
    "viem": "^2.0.0"
  },
  "devDependencies": {
    "web3-eth-accounts": "^1.7.4",
